# ============================================================
# Jira MCP Integration — Credential Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# --- Jira Cloud (https://your-org.atlassian.net) ---
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=you@yourcompany.com
JIRA_API_TOKEN=your_api_token_here

# --- Jira Project ---
# The short key shown in issue IDs, e.g. "NEXUS" in NEXUS-42
JIRA_PROJECT_KEY=KAN

# --- Jira Data Center / Server (on-premise) ---
# If using DC/Server, leave USERNAME + API_TOKEN blank and set PAT instead:
# JIRA_PERSONAL_TOKEN=your_personal_access_token_here

# --- Optional ---
JIRA_SSL_VERIFY=true

# ============================================================
# Miro Integration
# ============================================================
# Create an app at https://miro.com/app/settings/user-profile/apps,
# enable boards:read + boards:write, then use "Install app and get
# OAuth token" (not the Client ID/Secret on the App Credentials tab)
# to obtain the access token below.
MIRO_ACCESS_TOKEN=your_miro_access_token_here

# --- Gemini ---
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
